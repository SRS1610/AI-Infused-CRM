[
 {
  "id": "view_invoice_form",
  "model": "account.move",
  "type": "form",
  "name": "account.move.invoice.form",
  "chatter": true,
  "root": {
   "kind": "sheet",
   "children": [
    {
     "kind": "buttons",
     "children": [
      {
       "kind": "button",
       "method": "action_post",
       "label": "Confirm",
       "invisible": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "button",
       "method": "action_send",
       "label": "Send by email",
       "invisible": {
        "any": [
         [
          "state",
          "!=",
          "posted"
         ],
         [
          "move_type",
          "not_in",
          [
           "out_invoice",
           "out_refund"
          ]
         ]
        ]
       }
      },
      {
       "kind": "button",
       "method": "action_register_payment",
       "label": "Register payment",
       "dialog_title": "Register a payment",
       "submit_label": "Create payment",
       "params": [
        {
         "name": "amount",
         "label": "Amount (empty = everything due)",
         "type": "number"
        },
        {
         "name": "date",
         "label": "Payment date",
         "type": "date"
        },
        {
         "name": "communication",
         "label": "Memo",
         "type": "text"
        }
       ],
       "invisible": {
        "any": [
         [
          "state",
          "!=",
          "posted"
         ],
         [
          "payment_state",
          "not_in",
          [
           "not_paid",
           "partial"
          ]
         ]
        ]
       }
      },
      {
       "kind": "button",
       "method": "action_reverse",
       "label": "Credit note",
       "dialog_title": "Create a credit note",
       "submit_label": "Create",
       "params": [
        {
         "name": "reason",
         "label": "Reason",
         "type": "text"
        },
        {
         "name": "date",
         "label": "Credit note date",
         "type": "date"
        },
        {
         "name": "mode",
         "label": "What happens",
         "type": "select",
         "options": [
          [
           "refund",
           "Draft credit note to review"
          ],
          [
           "cancel",
           "Full refund: post and match with the invoice"
          ],
          [
           "modify",
           "Full refund and a new draft invoice to correct"
          ]
         ]
        }
       ],
       "invisible": [
        "state",
        "!=",
        "posted"
       ]
      },
      {
       "kind": "button",
       "method": "button_draft",
       "label": "Reset to draft",
       "invisible": {
        "any": [
         [
          "state",
          "!=",
          "posted"
         ],
         [
          "inalterable_hash",
          "!=",
          null
         ]
        ]
       }
      },
      {
       "kind": "button",
       "method": "button_cancel",
       "label": "Cancel",
       "confirm": "Cancel this entry? A posted entry keeps its number.",
       "invisible": [
        "state",
        "=",
        "cancel"
       ]
      }
     ]
    },
    {
     "kind": "field",
     "name": "name",
     "widget": "title",
     "readonly": true
    },
    {
     "kind": "group",
     "name": "main",
     "columns": 2,
     "children": [
      {
       "kind": "field",
       "name": "partner_id",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "invoice_date",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "payment_reference",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "payment_term_id",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "ref"
      },
      {
       "kind": "field",
       "name": "invoice_date_due",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "journal_id",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "currency_id",
       "readonly_if": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "field",
       "name": "state",
       "readonly": true,
       "widget": "badge"
      },
      {
       "kind": "field",
       "name": "payment_state",
       "readonly": true,
       "widget": "badge"
      },
      {
       "kind": "field",
       "name": "move_type",
       "invisible": [
        "id",
        "!=",
        -1
       ]
      },
      {
       "kind": "field",
       "name": "inalterable_hash",
       "invisible": [
        "id",
        "!=",
        -1
       ]
      }
     ]
    },
    {
     "kind": "notebook",
     "pages": [
      {
       "kind": "page",
       "name": "page_lines",
       "title": "Invoice lines",
       "children": [
        {
         "kind": "field",
         "name": "invoice_line_ids",
         "columns": [
          {
           "field": "product_id"
          },
          {
           "field": "name"
          },
          {
           "field": "account_id"
          },
          {
           "field": "quantity"
          },
          {
           "field": "price_unit"
          },
          {
           "field": "discount"
          },
          {
           "field": "tax_ids"
          },
          {
           "field": "price_subtotal"
          }
         ],
         "readonly_if": [
          "state",
          "!=",
          "draft"
         ]
        },
        {
         "kind": "group",
         "name": "totals",
         "columns": 1,
         "children": [
          {
           "kind": "field",
           "name": "amount_untaxed"
          },
          {
           "kind": "field",
           "name": "amount_tax"
          },
          {
           "kind": "field",
           "name": "amount_total"
          },
          {
           "kind": "field",
           "name": "amount_residual"
          }
         ]
        }
       ]
      },
      {
       "kind": "page",
       "name": "page_items",
       "title": "Journal items",
       "children": [
        {
         "kind": "field",
         "name": "line_ids",
         "readonly": true,
         "columns": [
          {
           "field": "account_id"
          },
          {
           "field": "partner_id"
          },
          {
           "field": "name"
          },
          {
           "field": "debit"
          },
          {
           "field": "credit"
          },
          {
           "field": "amount_currency"
          },
          {
           "field": "currency_id"
          },
          {
           "field": "date_maturity"
          },
          {
           "field": "reconciled"
          }
         ]
        }
       ]
      },
      {
       "kind": "page",
       "name": "page_other",
       "title": "Other information",
       "children": [
        {
         "kind": "group",
         "name": "other",
         "columns": 2,
         "children": [
          {
           "kind": "field",
           "name": "invoice_user_id",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          },
          {
           "kind": "field",
           "name": "fiscal_position_id",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          },
          {
           "kind": "field",
           "name": "invoice_origin",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          },
          {
           "kind": "field",
           "name": "date",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          },
          {
           "kind": "field",
           "name": "auto_post_date",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          },
          {
           "kind": "field",
           "name": "to_check"
          },
          {
           "kind": "field",
           "name": "company_id",
           "readonly_if": [
            "state",
            "!=",
            "draft"
           ]
          }
         ]
        },
        {
         "kind": "field",
         "name": "narration"
        }
       ]
      }
     ]
    }
   ]
  }
 },
