 {
  "id": "view_invoice_list",
  "model": "account.move",
  "type": "list",
  "name": "account.move.invoice.list",
  "columns": [
   {
    "field": "name"
   },
   {
    "field": "partner_id"
   },
   {
    "field": "invoice_date"
   },
   {
    "field": "invoice_date_due"
   },
   {
    "field": "invoice_origin",
    "optional": "hide"
   },
   {
    "field": "ref",
    "optional": "hide"
   },
   {
    "field": "amount_untaxed_signed",
    "sum": true,
    "label": "Untaxed"
   },
   {
    "field": "amount_total_signed",
    "sum": true,
    "label": "Total"
   },
   {
    "field": "amount_residual_signed",
    "sum": true,
    "label": "Amount due"
   },
   {
    "field": "payment_state",
    "widget": "badge"
   },
   {
    "field": "state",
    "widget": "badge"
   }
  ]
 },
 {
  "id": "view_move_list",
  "model": "account.move",
  "type": "list",
  "name": "account.move.list",
  "columns": [
   {
    "field": "date"
   },
   {
    "field": "name"
   },
   {
    "field": "journal_id"
   },
   {
    "field": "ref"
   },
   {
    "field": "partner_id"
   },
   {
    "field": "amount_total_signed",
    "sum": true,
    "label": "Amount"
   },
   {
    "field": "state",
    "widget": "badge"
   }
  ]
 },
 {
  "id": "view_move_search",
  "model": "account.move",
  "type": "search",
  "name": "account.move.search",
  "fields": [
   "name",
   "partner_id",
   "ref",
   "invoice_origin",
   "journal_id"
  ],
  "filters": [
   {
    "name": "draft",
    "label": "Draft",
    "domain": [
     [
      "state",
      "=",
      "draft"
     ]
    ]
   },
   {
    "name": "posted",
    "label": "Posted",
    "domain": [
     [
      "state",
      "=",
      "posted"
     ]
    ]
   },
   {
    "name": "unpaid",
    "label": "To collect / to pay",
    "domain": [
     [
      "state",
      "=",
      "posted"
     ],
     [
      "payment_state",
      "in",
      [
       "not_paid",
       "partial"
      ]
     ]
    ]
   },
   {
    "name": "overdue",
    "label": "Overdue",
    "domain": [
     [
      "state",
      "=",
      "posted"
     ],
     [
      "payment_state",
      "in",
      [
       "not_paid",
       "partial"
      ]
     ],
     [
      "invoice_date_due",
      "<",
      "$today"
     ]
    ]
   },
   {
    "name": "to_check",
    "label": "To check",
    "domain": [
     [
      "to_check",
      "=",
      true
     ]
    ]
   },
   {
    "name": "mine",
    "label": "My invoices",
    "domain": [
     [
      "invoice_user_id",
      "=",
      "$uid"
     ]
    ]
   }
  ],
  "group_bys": [
   {
    "field": "partner_id"
   },
   {
    "field": "state"
   },
   {
    "field": "payment_state"
   },
   {
    "field": "journal_id"
   },
   {
    "field": "invoice_date:month"
   }
  ]
 },
 {
  "id": "view_move_pivot",
  "model": "account.move",
  "type": "pivot",
  "name": "account.move.pivot",
  "row": "partner_id",
  "col": "invoice_date:month",
  "measures": [
   "amount_untaxed_signed"
  ]
 },
 {
  "id": "view_move_graph",
  "model": "account.move",
  "type": "graph",
  "name": "account.move.graph",
  "row": "invoice_date:month",
  "measures": [
   "amount_untaxed_signed"
  ]
 },
 {
  "id": "view_move_line_list",
  "model": "account.move_line",
  "type": "list",
  "name": "account.move_line.list",
  "columns": [
   {
    "field": "date"
   },
   {
    "field": "move_name"
   },
   {
    "field": "journal_id",
    "optional": "hide"
   },
   {
    "field": "account_id"
   },
   {
    "field": "partner_id"
   },
   {
    "field": "name"
   },
   {
    "field": "debit",
    "sum": true
   },
   {
    "field": "credit",
    "sum": true
   },
   {
    "field": "balance",
    "sum": true
   },
   {
    "field": "amount_currency",
    "optional": "hide"
   },
   {
    "field": "currency_id",
    "optional": "hide"
   },
   {
    "field": "date_maturity",
    "optional": "hide"
   },
   {
    "field": "amount_residual",
    "sum": true,
    "optional": "hide"
   },
   {
    "field": "full_reconcile_id",
    "optional": "hide"
   },
   {
    "field": "reconciled",
    "optional": "hide"
   }
  ]
 },
 {
  "id": "view_move_line_search",
  "model": "account.move_line",
  "type": "search",
  "name": "account.move_line.search",
  "fields": [
   "account_id",
   "partner_id",
   "move_name",
   "name",
   "journal_id"
  ],
  "filters": [
   {
    "name": "posted",
    "label": "Posted",
    "domain": [
     [
      "parent_state",
      "=",
      "posted"
     ]
    ]
   },
   {
    "name": "unreconciled",
    "label": "Open items",
    "domain": [
     [
      "reconciled",
      "=",
      false
     ],
     [
      "account_id.reconcile",
      "=",
      true
     ],
     [
      "parent_state",
      "=",
      "posted"
     ]
    ]
   },
   {
    "name": "receivable",
    "label": "Receivables",
    "domain": [
     [
      "account_id.account_type",
      "=",
      "asset_receivable"
     ]
    ]
   },
   {
    "name": "payable",
    "label": "Payables",
    "domain": [
     [
      "account_id.account_type",
      "=",
      "liability_payable"
     ]
    ]
   }
  ],
  "group_bys": [
   {
    "field": "account_id"
   },
   {
    "field": "partner_id"
   },
   {
    "field": "journal_id"
   },
   {
    "field": "date:month"
   }
  ]
 },
 {
  "id": "view_move_line_pivot",
  "model": "account.move_line",
  "type": "pivot",
  "name": "account.move_line.pivot",
  "row": "account_id",
  "col": "date:month",
  "measures": [
   "balance"
  ]
 },
 {
  "id": "view_payment_form",
  "model": "account.payment",
  "type": "form",
  "name": "account.payment.form",
  "chatter": true,
  "root": {
   "kind": "sheet",
   "children": [
    {
     "kind": "buttons",
     "children": [
      {
       "kind": "button",
       "method": "action_post",
       "label": "Confirm",
       "invisible": [
        "state",
        "!=",
        "draft"
       ]
      },
      {
       "kind": "button",
       "method": "action_cancel",
