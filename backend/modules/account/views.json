       "confirm": "Cancel this payment? Its matches with invoices are undone.",
       "invisible": [
        "state",
        "=",
        "cancel"
       ]
      }
     ]
    },
    {
     "kind": "field",
     "name": "name",
     "widget": "title",
     "readonly": true
    },
    {
     "kind": "group",
     "name": "main",
     "columns": 2,
     "children": [
      {
       "kind": "field",
       "name": "payment_type"
      },
      {
       "kind": "field",
       "name": "partner_type"
      },
      {
       "kind": "field",
       "name": "partner_id"
      },
      {
       "kind": "field",
       "name": "amount"
      },
      {
       "kind": "field",
       "name": "currency_id"
      },
      {
       "kind": "field",
       "name": "date"
      },
      {
       "kind": "field",
       "name": "journal_id"
      },
      {
       "kind": "field",
       "name": "payment_method"
      },
      {
       "kind": "field",
       "name": "ref"
      },
      {
       "kind": "field",
       "name": "state",
       "readonly": true,
       "widget": "badge"
      },
      {
       "kind": "field",
       "name": "is_matched",
       "readonly": true
      },
      {
       "kind": "field",
       "name": "is_reconciled",
       "readonly": true
      }
     ]
    },
    {
     "kind": "notebook",
     "pages": [
      {
       "kind": "page",
