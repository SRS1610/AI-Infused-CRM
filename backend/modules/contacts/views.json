     {"kind": "field", "name": "city"},
     {"kind": "field", "name": "tag_ids", "widget": "many2many_tags"}
   ]}},
  {"id": "view_partner_search", "model": "contacts.partner", "type": "search", "name": "contacts.partner.search",
   "fields": ["display_name", "email", "phone", "city"],
   "filters": [
     {"name": "companies", "label": "Companies", "domain": [["is_company", "=", true]]},
     {"name": "individuals", "label": "Individuals", "domain": [["is_company", "=", false]]},
     {"name": "mine", "label": "My contacts", "domain": [["user_id", "=", "$uid"]]},
     {"name": "archived", "label": "Archived", "domain": [["active", "=", false]]}
   ],
   "group_bys": [{"field": "country_id"}, {"field": "user_id"}, {"field": "industry_id"}, {"field": "is_company"}]}
]
