     ]},
     {"kind": "field", "name": "name", "widget": "title"},
     {"kind": "field", "name": "parent_id", "invisible": ["is_company", "=", true]},
     {"kind": "group", "name": "main", "columns": 2, "children": [
       {"kind": "field", "name": "type", "invisible": ["parent_id", "=", null]},
       {"kind": "field", "name": "function", "invisible": ["is_company", "=", true]},
       {"kind": "field", "name": "email", "widget": "email"},
       {"kind": "field", "name": "phone", "widget": "phone"},
       {"kind": "field", "name": "mobile", "widget": "phone"},
       {"kind": "field", "name": "website", "widget": "url"},
       {"kind": "field", "name": "street"},
       {"kind": "field", "name": "street2"},
       {"kind": "field", "name": "city"},
       {"kind": "field", "name": "zip"},
       {"kind": "field", "name": "state_id"},
       {"kind": "field", "name": "country_id"},
       {"kind": "field", "name": "vat"},
       {"kind": "field", "name": "tag_ids", "widget": "many2many_tags"}
     ]},
     {"kind": "notebook", "pages": [
       {"kind": "page", "name": "page_contacts", "title": "Contacts & addresses", "invisible": ["is_company", "=", false], "children": [{"kind": "field", "name": "child_ids"}]},
       {"kind": "page", "name": "page_sales", "title": "Sales", "children": [{"kind": "field", "name": "user_id"}, {"kind": "field", "name": "industry_id"}, {"kind": "field", "name": "ref"}, {"kind": "field", "name": "lang"}, {"kind": "field", "name": "company_id"}]},
       {"kind": "page", "name": "page_notes", "title": "Notes", "children": [{"kind": "field", "name": "comment"}]}
     ]}
   ]}},
  {"id": "view_partner_list", "model": "contacts.partner", "type": "list", "name": "contacts.partner.list",
   "columns": [{"field": "display_name"}, {"field": "email"}, {"field": "phone"}, {"field": "city"}, {"field": "country_id"}, {"field": "user_id", "optional": "hide"}, {"field": "tag_ids", "optional": "hide"}]},
  {"id": "view_partner_kanban", "model": "contacts.partner", "type": "kanban", "name": "contacts.partner.kanban",
   "root": {"kind": "card", "children": [
