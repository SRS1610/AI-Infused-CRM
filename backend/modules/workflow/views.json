  {"id": "view_automation_form", "model": "workflow.automation", "type": "form", "name": "workflow.automation.form",
   "root": {"kind": "sheet", "children": [
     {"kind": "buttons", "children": [{"kind": "button", "method": "action_regenerate_token", "label": "New webhook token", "invisible": ["trigger", "!=", "on_webhook"]}]},
     {"kind": "field", "name": "name", "widget": "title"},
     {"kind": "group", "name": "trigger", "title": "When", "columns": 2, "children": [
