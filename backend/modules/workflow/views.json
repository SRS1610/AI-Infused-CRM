       {"kind": "field", "name": "offset_days", "invisible": ["trigger", "!=", "on_time"]},
       {"kind": "field", "name": "transition_id", "invisible": ["trigger", "!=", "on_transition"]},
       {"kind": "field", "name": "webhook_token", "invisible": ["trigger", "!=", "on_webhook"], "readonly": true}
     ]},
