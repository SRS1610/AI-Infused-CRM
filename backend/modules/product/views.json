     {"name": "archived", "label": "Archived", "domain": [["active", "=", false]]}
   ],
   "group_bys": [{"field": "currency_id"}, {"field": "company_id"}]},
  {"id": "view_pricelist_item_form", "model": "product.pricelist_item", "type": "form", "name": "product.pricelist_item.form",
   "root": {"kind": "sheet", "children": [
     {"kind": "group", "name": "target", "title": "Applies to", "columns": 2, "children": [
       {"kind": "field", "name": "pricelist_id"}, {"kind": "field", "name": "applied_on"},
       {"kind": "field", "name": "category_id", "invisible": ["applied_on", "!=", "category"], "required_if": ["applied_on", "=", "category"]},
       {"kind": "field", "name": "product_id", "invisible": ["applied_on", "!=", "product"], "required_if": ["applied_on", "=", "product"]},
       {"kind": "field", "name": "variant_id", "invisible": ["applied_on", "!=", "variant"], "required_if": ["applied_on", "=", "variant"]},
       {"kind": "field", "name": "min_quantity"}, {"kind": "field", "name": "sequence"},
       {"kind": "field", "name": "date_start"}, {"kind": "field", "name": "date_end"}
     ]},
