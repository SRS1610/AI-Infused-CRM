  {"id": "view_pricelist_form", "model": "product.pricelist", "type": "form", "name": "product.pricelist.form",
   "root": {"kind": "sheet", "children": [
     {"kind": "field", "name": "name", "widget": "title"},
     {"kind": "group", "name": "main", "columns": 2, "children": [
       {"kind": "field", "name": "currency_id"}, {"kind": "field", "name": "company_id"},
       {"kind": "field", "name": "country_ids", "widget": "tags"}, {"kind": "field", "name": "sequence"},
       {"kind": "field", "name": "active"}
     ]},
     {"kind": "notebook", "pages": [
       {"kind": "page", "name": "page_rules", "title": "Price rules", "children": [
         {"kind": "field", "name": "item_ids", "editable": "bottom", "columns": [
           {"field": "sequence", "widget": "handle"}, {"field": "applied_on"}, {"field": "category_id"}, {"field": "product_id"},
           {"field": "variant_id"}, {"field": "min_quantity"}, {"field": "compute_price"}, {"field": "fixed_price"},
           {"field": "percent_price"}, {"field": "base", "optional": "show"}, {"field": "price_discount", "optional": "show"},
           {"field": "date_start", "optional": "hide"}, {"field": "date_end", "optional": "hide"}
         ]}
       ]}
     ]}
   ]}},
  {"id": "view_pricelist_list", "model": "product.pricelist", "type": "list", "name": "product.pricelist.list",
   "columns": [{"field": "sequence", "widget": "handle"}, {"field": "name"}, {"field": "currency_id"}, {"field": "company_id", "optional": "show"}, {"field": "country_ids", "widget": "tags", "optional": "show"}]},
  {"id": "view_pricelist_search", "model": "product.pricelist", "type": "search", "name": "product.pricelist.search",
   "fields": ["name", "country_ids"],
   "filters": [
