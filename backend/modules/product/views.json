[
  {"id": "view_product_form", "model": "product.product", "type": "form", "name": "product.product.form",
   "root": {"kind": "sheet", "children": [
     {"kind": "buttons", "children": [
       {"kind": "button", "method": "action_generate_variants", "label": "Generate variants", "invisible": ["is_template", "=", false]}
     ]},
     {"kind": "field", "name": "name", "widget": "title", "readonly_if": ["template_id", "!=", null]},
     {"kind": "group", "name": "main", "columns": 2, "children": [
       {"kind": "field", "name": "type", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "category_id", "readonly_if": ["template_id", "!=", null]},
