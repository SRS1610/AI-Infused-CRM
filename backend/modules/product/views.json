       {"kind": "field", "name": "compute_price"},
       {"kind": "field", "name": "fixed_price", "invisible": ["compute_price", "!=", "fixed"]},
       {"kind": "field", "name": "base", "invisible": ["compute_price", "=", "fixed"]},
       {"kind": "field", "name": "base_pricelist_id", "invisible": {"any": [["compute_price", "=", "fixed"], ["base", "!=", "pricelist"]]}},
       {"kind": "field", "name": "percent_price", "invisible": ["compute_price", "!=", "percentage"]},
       {"kind": "field", "name": "price_discount", "invisible": ["compute_price", "!=", "formula"]},
       {"kind": "field", "name": "price_round", "invisible": ["compute_price", "!=", "formula"]},
       {"kind": "field", "name": "price_surcharge", "invisible": ["compute_price", "!=", "formula"]},
       {"kind": "field", "name": "price_min_margin", "invisible": ["compute_price", "!=", "formula"]},
       {"kind": "field", "name": "price_max_margin", "invisible": ["compute_price", "!=", "formula"]}
     ]}
   ]}},
  {"id": "view_pricelist_item_list", "model": "product.pricelist_item", "type": "list", "name": "product.pricelist_item.list",
   "columns": [{"field": "pricelist_id"}, {"field": "display_name"}, {"field": "compute_price"}, {"field": "fixed_price"}, {"field": "percent_price"}, {"field": "date_start", "optional": "hide"}, {"field": "date_end", "optional": "hide"}]}
]
