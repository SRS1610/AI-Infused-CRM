  {"id": "view_product_search", "model": "product.product", "type": "search", "name": "product.product.search",
   "fields": ["name", "default_code", "barcode"],
   "filters": [
     {"name": "services", "label": "Services", "domain": [["type", "=", "service"]]},
     {"name": "goods", "label": "Goods", "domain": [["type", "=", "goods"]]},
     {"name": "templates", "label": "With variants", "domain": [["is_template", "=", true]]},
     {"name": "variants", "label": "Variants", "domain": [["template_id", "is_set"]]},
     {"name": "sellable", "label": "Sellable on a line", "domain": [["is_sellable", "=", true]]},
     {"name": "archived", "label": "Archived", "domain": [["active", "=", false]]}
   ],
   "group_bys": [{"field": "category_id"}, {"field": "type"}, {"field": "template_id"}]},
  {"id": "view_variant_list", "model": "product.product", "type": "list", "name": "product.product.variant.list",
