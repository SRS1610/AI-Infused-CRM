       {"kind": "field", "name": "price_extra", "readonly": true, "invisible": ["template_id", "=", null]},
       {"kind": "field", "name": "attribute_value_ids", "widget": "tags", "invisible": ["template_id", "=", null]},
       {"kind": "field", "name": "is_template", "readonly": true, "invisible": ["is_template", "=", false]}
     ]},
     {"kind": "notebook", "pages": [
       {"kind": "page", "name": "page_sales", "title": "Sales", "children": [
         {"kind": "field", "name": "description_sale", "readonly_if": ["template_id", "!=", null]},
         {"kind": "field", "name": "image", "widget": "image", "readonly_if": ["template_id", "!=", null]}
       ]},
       {"kind": "page", "name": "page_variants", "title": "Attributes & variants", "invisible": ["template_id", "!=", null], "children": [
         {"kind": "field", "name": "attribute_line_ids", "editable": "bottom", "columns": [{"field": "sequence", "widget": "handle"}, {"field": "attribute_id"}, {"field": "value_ids", "widget": "tags"}]},
         {"kind": "field", "name": "variant_count", "readonly": true, "invisible": ["is_template", "=", false]},
         {"kind": "field", "name": "variant_ids", "readonly": true, "invisible": ["is_template", "=", false], "columns": [{"field": "default_code"}, {"field": "attribute_value_ids", "widget": "tags"}, {"field": "barcode"}, {"field": "price_extra"}, {"field": "list_price"}]}
       ]}
     ]}
   ]}},
  {"id": "view_product_list", "model": "product.product", "type": "list", "name": "product.product.list",
   "columns": [{"field": "default_code"}, {"field": "name"}, {"field": "category_id"}, {"field": "type"}, {"field": "list_price"}, {"field": "standard_price", "optional": "hide"}, {"field": "uom_id", "optional": "hide"}, {"field": "variant_count", "optional": "hide"}]},
  {"id": "view_product_kanban", "model": "product.product", "type": "kanban", "name": "product.product.kanban",
