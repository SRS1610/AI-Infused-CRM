       {"kind": "field", "name": "list_price", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "standard_price", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "uom_id", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "tax_percent", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "sale_ok", "readonly_if": ["template_id", "!=", null]},
       {"kind": "field", "name": "company_id", "readonly_if": ["template_id", "!=", null]},
