#: closing.py:132
#, python-brace-format
msgid "Tax payable: {group}"
msgstr "Taxe à payer : {group}"

#: closing.py:132
#, python-brace-format
msgid "Tax credit: {group}"
msgstr "Crédit de taxe : {group}"

#: closing.py:118
msgid "Tax closing"
msgstr "Clôture des taxes"

#: closing.py:127
#, python-brace-format
msgid "Set the tax payable and receivable accounts of the tax group '{group}' to close the period"
msgstr "Renseignez les comptes de taxe à payer et à recevoir du groupe de taxes « {group} » pour clôturer la période"

#: models/tax_return.py:26
msgid "Dates use YYYY-MM-DD"
msgstr "Les dates s'écrivent AAAA-MM-JJ"

#: models/tax_return.py:102
#, python-brace-format
msgid "Tax return {start} - {end}"
msgstr "Déclaration de taxes {start} - {end}"

#: models/tax_return.py:111
msgid "The period of a closed tax return cannot change"
msgstr "La période d'une déclaration clôturée ne peut pas changer"

#: models/tax_return.py:116
msgid "A closed tax return cannot be deleted"
msgstr "Une déclaration clôturée ne peut pas être supprimée"

#: models/tax_return.py:182
msgid "Only accounting advisers can close a tax period"
msgstr "Seuls les conseillers comptables peuvent clôturer une période de taxes"

#: models/tax_return.py:77 models/tax_return.py:185
msgid "A tax period ends after it starts"
msgstr "Une période de taxes se termine après son début"

#: models/tax_return.py:191
#, python-brace-format
msgid "Taxes are already closed up to {date}"
msgstr "Les taxes sont déjà clôturées jusqu'au {date}"

#: models/tax_return.py:202
msgid "This tax period is already closed"
msgstr "Cette période de taxes est déjà clôturée"

#: models/tax_return.py:211
#, python-brace-format
msgid "The tax report differs from the tax accounts by {difference}: run the pre-filing checks first"
msgstr "Le rapport de taxes diffère des comptes de taxes de {difference} : lancez d'abord les contrôles avant dépôt"

#: models/tax_return.py:87
msgid "Tax returns of a company cannot overlap"
msgstr "Les déclarations de taxes d'une société ne peuvent pas se chevaucher"

#: models/tax_return.py:149
msgid "A closed tax return keeps the figures of its closing"
msgstr "Une déclaration clôturée conserve les montants de sa clôture"

#: models/tax_return.py:223
msgid "The company has no miscellaneous journal for the tax closing entry"
msgstr "La société n'a pas de journal des opérations diverses pour l'écriture de clôture des taxes"

#: models/tax_return.py:233
#, python-brace-format
msgid "Tax closing {start} - {end}"
msgstr "Clôture des taxes {start} - {end}"

#: prefiling.py:254
msgid "Error"
msgstr "Erreur"

#: prefiling.py:254
msgid "Warning"
msgstr "Avertissement"

#: prefiling.py:254
msgid "Information"
msgstr "Information"

#: prefiling.py:253
msgid "No findings"
msgstr "Aucun constat"

#: prefiling.py:64
#, python-brace-format
msgid "{count} taxes have no tax grid on their base or tax distribution"
msgstr "{count} taxes n'ont pas de case de déclaration sur leur répartition de base ou de taxe"

#: prefiling.py:85
#, python-brace-format
msgid "{count} entries have tax amounts outside every grid"
msgstr "{count} pièces ont des montants de taxe hors de toute case"

#: prefiling.py:111
#, python-brace-format
msgid "{count} reverse-charge or intra-EU documents have a partner without a tax ID"
msgstr "{count} documents en autoliquidation ou intracommunautaires ont un partenaire sans numéro de TVA"

#: prefiling.py:160
#, python-brace-format
msgid "{count} customer invoices use a tax that is unusual for the customer's country"
msgstr "{count} factures clients utilisent une taxe inhabituelle pour le pays du client"

#: prefiling.py:189
#, python-brace-format
msgid "{count} documents use another fiscal position than the partner's country and tax ID call for"
msgstr "{count} documents utilisent une autre position fiscale que celle qu'exigent le pays et le numéro de TVA du partenaire"

#: prefiling.py:209
#, python-brace-format
msgid "{count} draft entries are dated in the period"
msgstr "{count} pièces en brouillon sont datées dans la période"

#: prefiling.py:222
#, python-brace-format
msgid "The return (net {report}) differs from the tax accounts' movement ({ledger}) by {difference}"
msgstr "La déclaration (net {report}) diffère du mouvement des comptes de taxes ({ledger}) de {difference}"

#: prefiling.py:241
#, python-brace-format
msgid "Taxes are locked up to {date}"
msgstr "Les taxes sont verrouillées jusqu'au {date}"

