# Copy to .env for Docker Compose and local development. Never commit .env.

# --- Database ---------------------------------------------------------------
TESSERA_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/tessera
TESSERA_TEST_DATABASE_URL=postgresql://tessera:tessera@localhost:5432/tessera_test

# --- Redis (sessions, Celery broker, realtime bus, AI cache) -----------------
TESSERA_REDIS_URL=redis://localhost:6379/0

# --- Web ------------------------------------------------------------------
TESSERA_SECRET_KEY=change-me-32-bytes-minimum-for-session-signing
TESSERA_MASTER_KEY=change-me-base64-32-bytes-for-envelope-encryption
TESSERA_BASE_URL=http://localhost:8000
TESSERA_ALLOWED_HOSTS=localhost,127.0.0.1
TESSERA_ENV=development            # development | test | production

# --- Object storage (MinIO in dev) -------------------------------------------
TESSERA_STORAGE_BACKEND=s3        # s3 | filesystem
TESSERA_S3_ENDPOINT=http://localhost:9000
TESSERA_S3_BUCKET=tessera
TESSERA_S3_ACCESS_KEY=tessera
TESSERA_S3_SECRET_KEY=tessera-secret
TESSERA_STORAGE_PATH=./var/storage

# --- Mail (Mailpit in dev) ----------------------------------------------------
TESSERA_SMTP_HOST=localhost
TESSERA_SMTP_PORT=1025
TESSERA_MAIL_FROM=noreply@tessera.local

# --- AI gateway --------------------------------------------------------------
TESSERA_AI_GATEWAY_URL=http://localhost:8100
TESSERA_AI_GATEWAY_TOKEN=change-me-shared-service-token
# Provider keys are configured per company in the gateway's admin UI, stored encrypted.
# For local development you may seed them here (never in production):
# GATEWAY_ANTHROPIC_API_KEY=
# GATEWAY_OPENAI_API_KEY=
# GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
